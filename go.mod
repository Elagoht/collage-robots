// A collage plugin that serves robots.txt: rules per user agent, the sitemaps to
// read, and a switch that closes a staging site to every crawler.
//
// It requires collage the way any consumer does, and reaches nothing the framework
// does not offer every plugin.
module github.com/Elagoht/collage-robots

go 1.26

require github.com/Elagoht/collage v0.42.0
